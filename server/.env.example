# Server Configuration
PORT=5001
NODE_ENV=production

# Supabase Postgres Connection String (Session/Transaction Pooler URI from Supabase Dashboard -> Connect)
# Example: postgresql://postgres.[PROJECT_REF]:[YOUR_DB_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
SUPABASE_DB_URL=

# Optional fallback if using standard PostgreSQL instead of SUPABASE_DB_URL
DATABASE_URL=

# Security (REQUIRED in production - generate a 64-char random hex string)
JWT_SECRET=replace_with_64_char_random_hex_secret
CORS_ORIGIN=https://your-domain.com

# Stripe Integration (Optional server-wide defaults; users can also connect keys in Settings)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Monetization / Licensing (Polar.sh or custom license secret)
POLAR_ORGANIZATION_ID=
LICENSE_SALT=replace_with_random_license_salt
