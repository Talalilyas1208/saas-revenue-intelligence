/* RevTerm Modern Dark Theme (Stripe violet + carbon dark + emerald green) */

Screen {
    background: #0e1117;
    color: #e6edf3;
}

Header {
    background: #161b22;
    color: #635bff;
    dock: top;
    height: 1;
}

Footer {
    background: #161b22;
    color: #8b949e;
    dock: bottom;
    height: 1;
}

#kpi-row {
    layout: horizontal;
    height: auto;
    width: 100%;
    margin: 1 1 0 1;
}

#chart-container {
    height: auto;
    width: 100%;
    margin: 0 1 0 1;
}

#bottom-row {
    height: 1fr;
    margin: 0 1 1 1;
}

TabbedContent {
    height: 1fr;
    margin: 0 1 1 1;
}

TabPane {
    height: 1fr;
    padding: 0;
}

Tabs {
    dock: top;
    height: 3;
    background: #161b22;
}

Tab {
    padding: 0 2;
}

Tab:hover {
    color: #635bff;
}

Tab.-active {
    color: #635bff;
    text-style: bold;
    border-bottom: tall #635bff;
}
